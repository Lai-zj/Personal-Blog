{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "hexo clean && hexo generate && node tools/check-math.js",
    "check:math": "node tools/check-math.js",
    "clean": "hexo clean",
    "deploy": "hexo deploy",
    "server": "hexo server",
    "new": "hexo new --path",
    "assets": "find source/_posts -name '*.md' -exec sh -c 'for f; do mkdir -p \"${f%.md}\"; done' _ {} +"
  },
  "overrides": {
    "strip-ansi": "6.0.1"
  },
  "hexo": {
    "version": "8.1.2"
  },
  "dependencies": {
    "hexo": "^8.0.0",
    "hexo-deployer-git": "^4.0.0",
    "hexo-filter-mathjax": "^0.11.1",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^7.0.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-theme-landscape": "^1.0.0",
    "marked-footnote": "^1.4.0"
  }
}
